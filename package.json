{
  "name": "external-storage-guard",
  "version": "0.2.0",
  "description": "External storage diagnostics and confirmed safe remounts for SteamOS and Decky Loader",
  "type": "module",
  "license": "BSD-3-Clause",
  "author": "ohxiaoguang",
  "repository": {
    "type": "git",
    "url": "https://github.com/ohxiaoguang/decky-external-storage-guard.git"
  },
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "typecheck": "tsc --noEmit",
    "test": "python3 -m unittest discover -s tests -v",
    "check": "npm run typecheck && npm test && npm run build",
    "package": "npm run check && python3 scripts/package.py && python3 scripts/verify_package.py"
  },
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.11.0",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "@types/react-router": "^5.1.20",
    "rollup": "^4.53.3",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "react-icons": "^5.3.0",
    "tslib": "^2.7.0"
  }
}
